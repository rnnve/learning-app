{
  "cli": {
    "version": ">=19.0.8",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "bun": "1.4.4",
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease -PreactNativeArchitectures=armeabi-v7a,arm64-v8a -Pandroid.enableMinifyInReleaseBuilds=true -Pandroid.enableShrinkResourcesInReleaseBuilds=true"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://learning-app-api.rynni.cc"
      }
    },
    "universal": {
      "extends": "preview",
      "android": {
        "gradleCommand": ":app:assembleRelease -Pandroid.enableMinifyInReleaseBuilds=true -Pandroid.enableShrinkResourcesInReleaseBuilds=true"
      }
    }
  }
}
