{
  "name": "thai-study-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun run src/index.ts",
    "check": "biome check . && tsc --noEmit && bun test",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run scripts/migrate.ts",
    "verify:providers": "bun run scripts/verify-providers.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.0",
    "@elysiajs/swagger": "^1.3.0",
    "@google/genai": "^2.30.0",
    "@sinclair/typebox": "^0.34.47",
    "drizzle-orm": "^0.45.0",
    "elysia": "^1.4.30",
    "jose": "^6.0.8",
    "mammoth": "^1.9.1",
    "postgres": "^3.4.5",
    "sharp": "^0.33.5",
    "unpdf": "^1.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "latest",
    "drizzle-kit": "^0.30.5",
    "typescript": "^5.7.3"
  },
  "trustedDependencies": ["@biomejs/biome", "@google/genai", "protobufjs"]
}
