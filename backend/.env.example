NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
DATABASE_URL=postgres://thaistudy:change-me@db:5432/thaistudy
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-to-at-least-32-random-characters-long
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
STORAGE_DIR=/data/storage
DOCS_ENABLED=true
CORS_ORIGINS=
CONSENT_VERSION=2026-10-v1

# --- AI mode ---
AI_MODE=live

# --- Extraction: NeMo Retriever OCR v1 (full inference URL) ---
NEMOTRON_BASE_URL=https://ai.api.nvidia.com/v1/cv/nvidia/nemoretriever-ocr
NEMOTRON_API_KEY=
NEMOTRON_MODEL=nemoretriever-ocr-v1
NEMOTRON_TIMEOUT_MS=90000
NEMOTRON_MAX_OUTPUT_TOKENS=8192
NEMOTRON_REASONING=

# --- Generation: Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Content generation fallback (reuses NEMOTRON_API_KEY unless overridden)
NEMOTRON_GENERATION_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_GENERATION_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NEMOTRON_GENERATION_API_KEY=
GENERATION_PRIMARY_TIMEOUT_MS=30000
NEMOTRON_GENERATION_TIMEOUT_MS=60000
GEMINI_TIMEOUT_MS=90000
GEMINI_THINKING_LEVEL=

# --- Limits / quotas ---
MAX_IMAGE_BYTES=10485760
MAX_DOCUMENT_BYTES=26214400
MAX_IMAGES_PER_SOURCE=10
MAX_PDF_PAGES=100
OCR_PAGE_CAP=40
MAX_EXTRACTED_CHARS=1500000
MAX_GENERATIONS_PER_DAY=30
MAX_CHAT_MESSAGES_PER_DAY=200
RATE_LIMIT_GENERAL_PER_MIN=120
RATE_LIMIT_AUTH_PER_MIN=10
CHUNK_TARGET_CHARS=3500
CHUNK_OVERLAP_CHARS=300
DIRECT_CONTEXT_CHAR_BUDGET=60000
WORKER_ENABLED=true
WORKER_CONCURRENCY=2
